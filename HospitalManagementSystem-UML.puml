' ======================== APPOINTMENT & SCHEDULE ========================
class Appointment {
  - appointmentId: int
  - patientId: int
  - doctorId: int
  - timeSlotId: int
  - status: AppointmentStatus
  - reason: String
  - notes: String
  - medicalRecordId: int
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - cancelReason: String
  - completedAt: LocalDateTime
  --
  + confirm(): void
  + cancel(reason: String): boolean
  + reschedule(newDate: LocalDate, newTime: LocalTime): boolean
  + complete(): void
  + noShow(): void
  + updateNotes(notes: String): void
  + generateMedicalRecord(): MedicalRecord
  + getAppointmentInfo(): Map<String, Object>
  + sendReminderNotification(): void
  + displayInfo(): void
}

class Schedule {
  - scheduleId: int
  - doctorId: int
  - timeOffDates: List<LocalDate>
  - startTime: LocalTime
  - endTime: LocalTime
  - slotDuration: Duration
  - timeOffReasons: Map<LocalDate, String>
