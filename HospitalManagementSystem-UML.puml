  - date: LocalDate
  - startTime: LocalTime
  - endTime: LocalTime
  - duration: Duration
  - isAvailable: boolean
  - isBooked: boolean
  - appointmentId: int
  - createdAt: LocalDateTime
  --
  + overlaps(other: TimeSlot): boolean
  + getDuration(): Duration
  + bookSlot(appointmentId: int): void
  + releaseSlot(): void
  + isOverlapingWith(startTime: LocalTime, endTime: LocalTime): boolean
